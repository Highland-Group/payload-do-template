POSTGRES_PASSWORD=plzchangeMe
POSTGRES_DATABASE_NAME=pt-payload-poc

# Database connection string (PostgreSQL 17)
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DATABASE_NAME}

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

SPACES_KEY_ID=REPLACE_ME
SPACES_SECRET_KEY=REPLACE_ME
SPACES_BUCKET_NAME=payload-do-template
SPACES_REGION=nyc3
